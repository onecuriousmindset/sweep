{
  "manifest_version": 3,
  "name": "Sweep",
  "version": "1.0.0",
  "description": "Sweep your feed clean, in plain words. Hide AI replies, engagement bait and more on X, Reddit, LinkedIn and Hacker News.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "permissions": ["storage"],
  "host_permissions": ["https://api.typesafe.ai/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sweep",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" }
  },
  "options_ui": { "page": "welcome.html", "open_in_tab": true },
  "content_scripts": [
    {
      "matches": [
        "https://news.ycombinator.com/*",
        "https://www.reddit.com/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.linkedin.com/*"
      ],
      "js": ["defaults.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
